#!/usr/bin/env bash
# pre-commit hook: the secret boundary lives on the laptop, not in CI.
#
# On a public repository a pushed branch is already public, so a scan that only runs after the
# push runs too late. Three jobs, in order:
#   0. gitleaks on the staged changes (default rules + this repo's tripwires), fail closed
#   1. Lua files must compile
#   2. staged markdown is checked against the house style script named in git config
#      hooks.prose-style-check (typographic dashes block, flagged phrases warn); skipped where unset
#
# Install: git config core.hooksPath .githooks
# Bypass:  git commit --no-verify   (the pre-push hook and CI re-check everything anyway)
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# The maintainer's clone sets `git config hooks.maintainer true`: it carries a gitignored
# .gitleaks.local.toml of literal tripwires and refuses to run without it. Every other clone scans
# with the tracked public config, the same rules CI runs.
MAINTAINER="$(git config --get hooks.maintainer || true)"
GL_CONFIG="$REPO_ROOT/.gitleaks.local.toml"
if [ ! -f "$GL_CONFIG" ]; then
  if [ "$MAINTAINER" = "true" ]; then
    echo "BLOCKED. $GL_CONFIG is missing and this clone requires it; restore it from the private store before committing."
    exit 1
  fi
  GL_CONFIG="$REPO_ROOT/.gitleaks.toml"
fi
STYLE_SCRIPT="$(git config --get hooks.prose-style-check || true)"

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
STAGED_MD=$(echo "$STAGED_ALL" | grep -E '\.md$' || true)
STAGED_LUA=$(echo "$STAGED_ALL" | grep -E '\.lua$' || true)

# Job 0: secrets + sanitization gate. Fail closed: no scanner, no commit.
if [ -n "$STAGED_ALL" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --pre-commit --staged --redact --config "$GL_CONFIG" >/dev/null 2>&1; then
      echo "pre-commit: BLOCKED. gitleaks found a secret or sanitization tripwire in staged changes:"
      gitleaks git --pre-commit --staged --redact --config "$GL_CONFIG" 2>&1 \
        | grep -E "RuleID:|File:|Line:" | head -12 || true
      echo "Fix the content (do not allowlist around it), restage, retry."
      exit 1
    fi
    echo "pre-commit: gitleaks clean."
  else
    echo "pre-commit: BLOCKED. gitleaks not installed (brew install gitleaks)."
    echo "Refusing to commit unscanned to a public repo."
    exit 1
  fi
fi

# Job 1: Lua must compile (luajit -bl lists bytecode without running anything).
if [ -n "$STAGED_LUA" ] && command -v luajit >/dev/null 2>&1; then
  for f in $STAGED_LUA; do
    if ! luajit -bl "$REPO_ROOT/$f" >/dev/null 2>&1; then
      echo "pre-commit: BLOCKED. $f does not compile:"
      luajit -bl "$REPO_ROOT/$f" 2>&1 | head -3
      exit 1
    fi
  done
  echo "pre-commit: Lua compiles."
fi

# Job 2: house style on staged markdown (script lives outside the repo; skipped where unset).
if [ -n "$STAGED_MD" ] && [ -n "$STYLE_SCRIPT" ] && [ -x "$STYLE_SCRIPT" ]; then
  OUTPUT=$(python3 "$STYLE_SCRIPT" $STAGED_MD 2>&1) || true
  if echo "$OUTPUT" | grep -qE 'em=[1-9]|en=[1-9]|dashes=[1-9]'; then
    echo "pre-commit: BLOCKED. Typographic dashes (em, en, double hyphen) in staged markdown."
    echo "$OUTPUT" | grep -E 'em=|en=|dashes='
    exit 1
  fi
  if echo "$OUTPUT" | grep -qE 'ai_tells=|juxt='; then
    echo "pre-commit: WARNING. House-style phrases found. Review with: python3 $STYLE_SCRIPT -v $STAGED_MD"
    echo "$OUTPUT" | grep -E 'ai_tells=|juxt='
  fi
fi

echo "pre-commit: done."
exit 0
